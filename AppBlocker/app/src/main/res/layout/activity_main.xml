<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="AppBlocker"
            android:textColor="@color/brand_primary_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Protege tu tranquilidad, llamada a llamada."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRequestRole"
        style="@style/Widget.AppBlocker.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:drawablePadding="8dp"
        android:text="Activar filtro de llamadas" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tab_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <Button
            android:id="@+id/btnBlockedTab"
            style="@style/Widget.AppBlocker.TabButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Bloqueos" />

        <Button
            android:id="@+id/btnWhitelistTab"
            style="@style/Widget.AppBlocker.TabButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Lista blanca" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_rule_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEditorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nueva regla de bloqueo"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelEdit"
                style="@style/Widget.AppBlocker.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Cancelar"
                android:visibility="gone" />
        </LinearLayout>

        <EditText
            android:id="@+id/etPrefix"
            style="@style/Widget.AppBlocker.EditText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Prefijo o número (ej. 400)"
            android:inputType="phone"
            android:maxLength="24"
            android:singleLine="true" />

        <RadioGroup
            android:id="@+id/matchTypeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp">

            <RadioButton
                android:id="@+id/rbPrefixMatch"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:buttonTint="@color/brand_primary"
                android:checked="true"
                android:text="Empieza por"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbExactMatch"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="18dp"
                android:buttonTint="@color/brand_primary"
                android:text="Número exacto"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/priorityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPriority"
                style="@style/Widget.AppBlocker.EditText"
                android:layout_width="96dp"
                android:layout_height="46dp"
                android:hint="Prioridad"
                android:inputType="numberSigned"
                android:maxLength="7"
                android:singleLine="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Mayor valor primero; en empate, gana el prefijo más largo."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveRule"
            style="@style/Widget.AppBlocker.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:text="Añadir regla" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etSimulateNumber"
            style="@style/Widget.AppBlocker.EditText"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:hint="Probar un número"
            android:inputType="phone"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnSimulate"
            style="@style/Widget.AppBlocker.SecondaryButton"
            android:layout_width="92dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="Simular" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_rule_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBlockedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/status_blocked"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Llamadas bloqueadas"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAllowedCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/status_allowed"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Llamadas permitidas"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tus reglas"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRulesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 reglas"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="Todavía no hay reglas de bloqueo."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnImportCsv"
            style="@style/Widget.AppBlocker.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Importar CSV" />

        <Button
            android:id="@+id/btnExportCsv"
            style="@style/Widget.AppBlocker.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Exportar CSV" />

        <Button
            android:id="@+id/btnViewLogs"
            style="@style/Widget.AppBlocker.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Actividad" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSmsFeature"
        style="@style/Widget.AppBlocker.SecondaryButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:text="Filtro inteligente de SMS" />
</LinearLayout>
