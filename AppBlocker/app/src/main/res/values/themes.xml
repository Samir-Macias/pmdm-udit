<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AppBlocker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/brand_primary_dark</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/screen_background</item>
    </style>

    <style name="Widget.AppBlocker.PrimaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.AppBlocker.SecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/brand_primary_light</item>
        <item name="android:textColor">@color/brand_primary_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.AppBlocker.DangerButton" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/danger_light</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.AppBlocker.TextButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.AppBlocker.TabButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/bg_tab_selector</item>
        <item name="android:textColor">@color/tab_text_selector</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.AppBlocker.EditText" parent="android:style/Widget.Material.Light.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:backgroundTint">@color/divider</item>
    </style>
</resources>